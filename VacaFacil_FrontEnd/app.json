{
  "expo": {
    "name": "VacaFacil",
    "slug": "VacaFacil_FrontEnd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vacafacil",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/d9bb7f61-3047-4686-a2bc-f84b31e208d2",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.foaozin.VacaFacil_FrontEnd",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O VacaFácil precisa acessar sua galeria para adicionar fotos.",
          "cameraPermission": "O VacaFácil precisa da câmera para tirar fotos."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0d631b",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9bb7f61-3047-4686-a2bc-f84b31e208d2"
      }
    },
    "owner": "vitor_afonso"
  }
}
